# Server
ZINAR_PORT=1892
ZINAR_HOST=0.0.0.0
ZINAR_PREFIX=
ZINAR_DEBUG=0

# Security
ZINAR_SECRET_KEY=change-this-to-a-secure-random-string

# Database
